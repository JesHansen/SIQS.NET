<svg class="medallion" viewBox="0 0 64 64" aria-hidden="true">
    <circle cx="32" cy="32" r="30" style="fill:hsl(@Hue 40% 25%);stroke:hsl(@Hue 60% 55%);stroke-width:2" />
    <text x="32" y="39" text-anchor="middle">@Initials</text>
</svg>

@code {
    [Parameter, EditorRequired]
    public string Initials { get; set; } = string.Empty;

    [Parameter]
    public int Hue { get; set; }
}
