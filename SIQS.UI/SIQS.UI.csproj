<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\SIQS.Pipeline\SIQS.Pipeline.csproj" />
    <ProjectReference Include="..\SIQS.Contracts\SIQS.Contracts.csproj" />
    <ProjectReference Include="..\SIQS.Overlord\SIQS.Overlord.csproj" />
  </ItemGroup>

  <!-- TargetFramework, Nullable, and ImplicitUsings come from Directory.Build.props. -->
  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <Target Name="PublishDistributedSieveClient" AfterTargets="Publish">
    <MSBuild
      Condition="'$(SkipSieveClientPublish)' != 'true'"
      Projects="..\QS.SieveClient\QS.SieveClient.csproj"
      Targets="Restore;Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;DebugType=None;DebugSymbols=false;PublishDir=$(MSBuildProjectDirectory)\download\windows-x64\"
      BuildInParallel="false" />
    <MSBuild
      Condition="'$(SkipSieveClientPublish)' != 'true'"
      Projects="..\QS.SieveClient\QS.SieveClient.csproj"
      Targets="Restore;Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=linux-x64;SelfContained=true;PublishSingleFile=true;DebugType=None;DebugSymbols=false;PublishDir=$(MSBuildProjectDirectory)\download\linux-x64\"
      BuildInParallel="false" />
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\download\windows-x64\qs-sieve-client.exe"
      DestinationFolder="$(PublishDir)download\windows-x64\"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\download\linux-x64\qs-sieve-client"
      DestinationFolder="$(PublishDir)download\linux-x64\"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
