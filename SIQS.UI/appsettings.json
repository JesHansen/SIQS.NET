{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Distributed sieving coordination. These mirror the defaults in SIQS.Overlord/OverlordService.cs
  // and are repeated here so they are discoverable and overridable without a rebuild.
  "Overlord": {
    // A-candidates handed out per lease, and how that scales with a worker's reported core count.
    "LeaseChunkSize": 64,
    "LeaseItemsPerWorker": 8,
    "MinLeaseChunkSize": 1,
    "MaxLeaseChunkSize": 384,
    // 50 GiB (53687091200 bytes). This caps *unprocessed* upload backlog in a job's inbox, not the
    // relation stream as a whole: once a chunk is ingested it is replaced by a compact receipt. It
    // is deliberately far larger than any healthy backlog, because hitting it means workers are
    // uploading faster than the server ingests, and rejecting their work is the last resort. Lower
    // it if the server's disk is smaller than this.
    "MaxRelationBacklogBytes": 53687091200,
    "MaxRelationInboxBytes": 53754200064,
    "RetainRelationInboxOnCompletion": false
  },
  "AllowedHosts": "*"
}
